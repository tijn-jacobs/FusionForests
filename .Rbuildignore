^sticker$
^simulations$
^\.devcontainer$
^\.claude$
^LICENSE\.md$
^CONTRIBUTING\.md$
^info$
^examples$
^notes$

## Heavy folders not part of the package proper
^archive$
^backups$
## Private data (local only); data/ holds package data only
^data-private$
^manuscripts$
^\.vscode$

## Vignette sources: CRAN renders the precomputed FusionForests.Rmd only
^vignettes/.*\.Rmd\.orig$
^vignettes/precompile\.R$
^vignettes/FEATURE_NOTES\.md$
^vignettes/cache$

## Compiler scratch files that R CMD build's cleanup does not know
^src/.*\.o\.tmp$

## Stray files at the repo root
^\.RDataTmp$
^\.Rhistory$
^\.DS_Store$
^CLAUDE\.md$
^Rplots\.pdf$
